  m_Script: {fileID: 11500000, guid: f989889b4b1125d42842fc925c59a6fa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questionText: {fileID: 1225686297}
  choiceTexts:
  - {fileID: 960823181}
  - {fileID: 1815547107}
  - {fileID: 362635365}
  - {fileID: 1365481412}
  choiceButtons:
  - {fileID: 2142255321}
  - {fileID: 1881588360}
  - {fileID: 2101093953}
  - {fileID: 2023886196}
  resultPanel: {fileID: 546321256}
  scoreText: {fileID: 1879967519}
  questions:
  - questionText: 1. What is a soccer ball typically made of and how is it used?
    choices:
    - Leather or synthetic material, but mainly carried by hand
    - Leather or synthetic material, filled with air, and kicked during the game
    - Rubber, solid inside, and thrown like a baseball
    - Plastic, hollow, and bounced on the ground
    correctIndex: 1
  - questionText: 2. What are the standard dimensions of a FIFA international soccer
      field?
    choices:
    - "100\u2013110 meters long and 64\u201375 meters wide"
    - "90\u2013100 meters long and 60\u201370 meters wide"
    - "120\u2013130 meters long and 80\u201390 meters wide"
    - "80\u201390 meters long and 50\u201360 meters wide"
    correctIndex: 0
  - questionText: 3. Who can use their hands in football (soccer) during play?
    choices:
    - Only forwards
    - Only defenders
    - Any player at any time
    - Only the goalkeeper within the penalty area
    correctIndex: 3
  - questionText: 4. When and where was the modern version of football (soccer) officially
      standardized?
    choices:
    - 1863 in England, when the Football Association (FA) was formed
    - 1904 in France, when FIFA was established
    - 1800 in Germany, with the first local clubs
    - 1863 in Scotland, with the Scottish Football Association
    correctIndex: 0
  - questionText: 5. During a match, Alex trips an opposing player while trying to
      take the ball. What should the referee call?
    choices:
    - A corner kick because the ball went out of play
    - A handball because the player used their foot incorrectly
    - An offside because the player touched the ball too early
    - A foul for physical misconduc
    correctIndex: 3
  - questionText: 6. During a match, a defender slides to take the ball from an attacker
      but makes contact with the player instead of the ball. What should the referee
      call?
    choices:
    - A clean tackle and play continues
    - A foul for dangerous or excessive force
    - A handball because the defender touched the attacker
    - An offside for the attacker
    correctIndex: 1
  - questionText: 7. What is the main purpose of passing in football (soccer)?
    choices:
    - 'To accurately move the ball to teammates to maintain possession and create
      scoring opportunities '
    - "To kick the ball as hard as possible toward the opponent\u2019s goal"
    - To stop the clock during play
    - To confuse the referee
    correctIndex: 0
  - questionText: 8. What is the purpose of juggling in soccer?
    choices:
    - To pass the ball to the goalkeeper
    - To score directly from a high kick
    - To dribble past opponents as fast as possible
    - To keep the ball in the air using feet, thighs, chest, or head to improve touch,
      control, balance, and focus
    correctIndex: 3
  - questionText: 9. What happens when a player receives a red card in soccer?
    choices:
    - 'The player is ejected immediately, leaving the team one player short '
    - The player is given a warning but can continue playing
    - The player can stay on the field but cannot score goals
    - The player must sit out for 5 minutes before rejoining
    correctIndex: 0
  - questionText: 10. What is considered a handball in soccer?
    choices:
    - When a player accidentally touches the ball with their shoulder
    - When a player deliberately touches the ball with their hand or arm
    - When a player kicks the ball out of bounds
    - When a goalkeeper catches the ball inside their own penalty area
    correctIndex: 1
  clickSound: {fileID: 757131865}
