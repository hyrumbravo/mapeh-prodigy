MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1466153547}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f989889b4b1125d42842fc925c59a6fa, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  questionText: {fileID: 1101769625}
  choiceTexts:
  - {fileID: 315909262}
  - {fileID: 550928360}
  - {fileID: 1017827451}
  - {fileID: 1746955994}
  choiceButtons:
  - {fileID: 1663655639}
  - {fileID: 493718585}
  - {fileID: 1678455212}
  - {fileID: 1715980235}
  resultPanel: {fileID: 546321256}
  scoreText: {fileID: 1879967519}
  questions:
  - questionText: 1.Which of the following best describes a standard ping pong ball?
    choices:
    - Small, heavy, solid, made of rubber, usually white or orange
    - Large, lightweight, hollow, made of plastic, white and orange
    - Small, lightweight, solid, made of wood, usually white
    - Small, lightweight, hollow, made of durable plastic, usually white or orange
    correctIndex: 3
  - questionText: 2.What are the characteristics of a standard table tennis racket?
    choices:
    - Flat, round wooden blade with rubber on only one side; handle is long for leverage
    - Round metal blade with no rubber; handle is short
    - Flat, round wooden blade covered with red and black rubber on opposite sides;
      handle is short for grip
    - Flat, round wooden blade covered with rubber of the same color on both sides
    correctIndex: 2
  - questionText: 3. What are the standard dimensions of a table tennis table and
      its net?
    choices:
    - 9 ft long, 5 ft wide, 2.5 ft high; net 6 inches high
    - 8 ft long, 4 ft wide, 2.5 ft high; net 6 inches high
    - 9 ft long, 5 ft wide, 3 ft high; net 8 inches high
    - 10 ft long, 5 ft wide, 2.5 ft high; net 6 inches high
    correctIndex: 0
  - questionText: 4. Who is credited with inventing table tennis?
    choices:
    - David Fouster
    - William G. Morgan
    - David Foster
    - John McEnroe
    correctIndex: 2
  - questionText: "5. When was table tennis officially called \u201Ctable tennis\u201D
      instead of Ping-Pong?"
    choices:
    - 1920s
    - 1890s
    - 1940s
    - 1900s
    correctIndex: 0
  - questionText: 6. What is the main objective of table tennis?
    choices:
    - "Hit the ball over the net to the opponent\u2019s side as fast as possible"
    - Keep the ball in the air without letting it bounce
    - Hit the ball into a goal on the table
    - Hit the ball over the net so it bounces on the opponent's side, making it hard
      for them to return
    correctIndex: 3
  - questionText: 7. What is a forehand in table tennis?
    choices:
    - ' A basic stroke where you hit the ball with the paddle on the same side as
      your dominant hand'
    - A stroke where you hit the ball on the opposite side of your dominant hand
    - A stroke that always spins the ball
    - A serve from behind the table
    correctIndex: 0
  - questionText: 8. Who is the 5-time US table tennis champion?
    choices:
    - David Foster
    - James Naismith
    - Dan Seemiller
    - William G. Morgan
    correctIndex: 2
  - questionText: 9. What is a backhand in table tennis?
    choices:
    - 'A stroke where you hit the ball with the paddle on the opposite side of your
      dominant hand '
    - A stroke where you hit the ball on the same side as your dominant hand
    - A stroke used only for serving
    - A stroke that hits the ball without using the paddle
    correctIndex: 0
  - questionText: 10.During a rally, Sam hits the ball before it bounces on his side
      of the table. What is the correct call?
    choices:
    - None, because volleying is allowed during rally
    - Let, and the rally is repeated
    - Legal shot, continue play
    - Fault for volleying
    correctIndex: 3
  clickSound: {fileID: 757131865}
